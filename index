    const INDICES_SPRITES = {};

    function resolverSprite(emocion, pasoSecuencia = true) {
        const set = SETS_AVATARES[config.setActivo] || SETS_AVATARES['natsuki_escuela'];
        const recurso = set.sprites[emocion] || set.sprites.normal;

        if (Array.isArray(recurso)) {
            const claveControl = `${config.setActivo}_${emocion}`;
            if (INDICES_SPRITES[claveControl] === undefined) {
                INDICES_SPRITES[claveControl] = 0;
            }

            const indice = INDICES_SPRITES[claveControl];
            const archivo = recurso[indice];

            if (pasoSecuencia) {
                INDICES_SPRITES[claveControl] = (indice + 1) % recurso.length;
            }
            return archivo;
        }
        return recurso;
    }

