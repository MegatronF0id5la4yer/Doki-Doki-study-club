    function renderizarSelectorAvatares() {
        const cont = document.getElementById('selector-avatar-container');
        const skinsDelPersonaje = Object.entries(SETS_AVATARES).filter(([key, set]) => set.personaje === personajeViendo);

        let html = `
            <div class="selector-panel">
                <div class="selector-header">SELECCIONAR PERSONAJE</div>
                <div class="selector-grid">
                    <div class="selector-card ${personajeViendo === 'natsuki' ? 'viendo' : ''}" onclick="cambiarPestanaSelector('natsuki')">Natsuki</div>
                    <div class="selector-card ${personajeViendo === 'yuri' ? 'viendo' : ''}" onclick="cambiarPestanaSelector('yuri')">Yuri</div>
                    <div class="selector-card ${personajeViendo === 'monika' ? 'viendo' : ''}" onclick="cambiarPestanaSelector('monika')">Monika</div>
                    <div class="selector-card ${personajeViendo === 'sayori' ? 'viendo' : ''}" onclick="cambiarPestanaSelector('sayori')">Sayori</div>
                    <div class="selector-card ${personajeViendo === 'custom' ? 'viendo' : ''}" style="grid-column: span 2;" onclick="cambiarPestanaSelector('custom')">Sujetos de Prueba</div>
                </div>
                <div class="selector-header">SKINS DISPONIBLES</div>
                <div class="grid-tarjetas">
        `;

        skinsDelPersonaje.forEach(([key, set]) => {
            const esActivo = configGlobal.setAvatarActivo === key;
            const primerSprite = obtenerPrimerSprite(set.sprites.normal);
            html += `
                <div class="tarjeta-item ${esActivo ? 'activo' : ''}"
                     style="background-image: url('${primerSprite}')"
                     onclick="seleccionarSetAvatar('${key}')">
                    <div class="tarjeta-label">${set.nombre}</div>
                </div>
            `;
        });

        html += `</div></div>`;
        cont.innerHTML = html;
    }

