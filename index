    let pendejometro = 0;

    function handleConsolaIA(input, log) {
        const text = input.toLowerCase();
        let respuesta = null;

        for (const item of consolaIADict) {
            if (item.words.some(w => text.includes(w))) {
                respuesta = item.responses[Math.floor(Math.random() * item.responses.length)];
                break;
            }
        }

        if (respuesta) {
            log.innerText += `\n[IA] ${respuesta}`;
            pendejometro = Math.max(0, pendejometro - 1);
            return;
        }

        const fallback = consolaIAFallbacks[Math.floor(Math.random() * consolaIAFallbacks.length)];
        pendejometro++;
        if (pendejometro >= 5) {
            pendejometro = 0;
            log.innerText += "\n[SYSTEM] Demasiados comandos sin sentido. Colapsando la simulación...";
            setTimeout(ejecutarExplote, 500);
            return;
        }
        log.innerText += `\n[-] '${input}': comando no reconocido. ${fallback} (intento #${pendejometro})`;
    }

