    // ===== Comportamiento extendido de la consola (adaptado, sin personas reales) =====

    // --- Cifrado "meme" tipo César, usando solo palabras de meme genéricas ---
    const MEME_KEY = 6;
    const MEME_LOWER = ['esmegma','noob','sanic','gigachad','doge','coff','frog','bruh','waluigi','soyjak','wojak','troll','spam','goblin','ricardo','derp','suq','bonjour','cheems','cyblyat','uwu','gustav','mraow','roblox','boy','lutz'];
    const MEME_UPPER = MEME_LOWER.map(w => w.toUpperCase());
    const MEME_NUMS = ['subzero','numberone','despacito2','halflife3','chan4','highfive','order66','granddad7','mate8','nein9'];
    const MEME_JUNK_POOL = MEME_LOWER.concat(MEME_NUMS);
    let memeLangActive = false;

    function memeJunkWord() { return MEME_JUNK_POOL[Math.floor(Math.random() * MEME_JUNK_POOL.length)]; }

    function memeCesarEncode(text) {
        const out = [];
        for (const c of String(text)) {
            if (/[a-z]/.test(c)) {
                const pos = c.charCodeAt(0) - 97; const cipherPos = (pos + MEME_KEY) % 26;
                out.push(MEME_LOWER[cipherPos]); for (let j = 0; j < cipherPos + 1; j++) out.push(memeJunkWord());
            } else if (/[A-Z]/.test(c)) {
                const pos = c.charCodeAt(0) - 65; const cipherPos = (pos + MEME_KEY) % 26;
                out.push(MEME_UPPER[cipherPos]); for (let j = 0; j < cipherPos + 1; j++) out.push(memeJunkWord());
            } else if (/[0-9]/.test(c)) {
                const n = parseInt(c, 10); out.push(MEME_NUMS[n]); for (let j = 0; j < n + 1; j++) out.push(memeJunkWord());
            } else if (c === ' ') { out.push('_'); } else { out.push(c); }
        }
        return out.join(' ');
    }

    function memeCesarDecode(memeText) {
        const tokens = String(memeText).trim().split(/\s+/).filter(Boolean);
        let result = ''; let i = 0;
        while (i < tokens.length) {
            const tok = tokens[i];
            if (tok === '_') { result += ' '; i++; continue; }
            let idx = MEME_LOWER.indexOf(tok);
            if (idx > -1) { const origPos = ((idx - MEME_KEY) % 26 + 26) % 26; result += String.fromCharCode(97 + origPos); i = i + 1 + (idx + 1); continue; }
            idx = MEME_UPPER.indexOf(tok);
            if (idx > -1) { const origPos = ((idx - MEME_KEY) % 26 + 26) % 26; result += String.fromCharCode(65 + origPos); i = i + 1 + (idx + 1); continue; }
            idx = MEME_NUMS.findIndex(w => w.toLowerCase() === tok.toLowerCase());
            if (idx > -1) { result += String(idx); i = i + 1 + (idx + 1); continue; }
            result += tok; i++;
        }
        return result;
    }

    function handleMemeCommand(arg, log) {
        if (!arg) { log.innerText += "\n[-] Uso: meme on | off | cifrar <txto> | descifrar <txto>"; return; }
        const p = arg.split(/\s+/);
        const sub = p[0].toLowerCase();
        if (sub === 'on') { memeLangActive = true; log.innerText += "\n[+] Traductor meme-cesar: ACTIVO"; }
        else if (sub === 'off') { memeLangActive = false; log.innerText += "\n[+] Traductor meme-cesar: INACTIVO"; }
        else if (sub === 'cifrar') { log.innerText += "\n[*] " + memeCesarEncode(p.slice(1).join(' ')); }
        else if (sub === 'descifrar') { log.innerText += "\n[*] " + memeCesarDecode(p.slice(1).join(' ')); }
        else { log.innerText += "\n[-] Subcomando inválido."; }
    }

