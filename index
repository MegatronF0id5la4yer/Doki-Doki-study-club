            let emocionPedida = (typeof item === 'object' && item.emocion) ? item.emocion.toLowerCase() : 'normal';
            if (!['normal', 'pensando', 'examen', 'feliz', 'molesta'].includes(emocionPedida)) {
                emocionPedida = 'normal';
