        textDialog.style.display = 'block';
        optionsDiv.style.display = 'none';
        btnNext.style.display = 'none';
        btnDuda.style.display = 'none';

        const sujetoActual = SETS_AVATARES[config.setActivo]?.personaje || 'natsuki';
        nameBox.innerText = sujetoActual;

        if (!config.apiKey) {
            sprite.src = resolverSprite('molesta', true);
            estadoActual = 'terminado';
            btnNext.style.display = 'block';
            escribirTexto("No has configurado tu API Key en los Ajustes. Ve a la pestaña 'IA & Prompts' y pégala para que podamos estudiar.");
            return;
        }

        textDialog.innerHTML = '<span class="loading-dots">Preparando la lección</span>';
        sprite.src = resolverSprite('pensando', true);
        reproducirBGM('teoria');

        const promptMateria = `Genera una lección didáctica y detallada de ${nombreMat} para el nivel ${nivelActual}.
Responde ESTRICTAMENTE con un objeto JSON sin markdown ni explicaciones adicionales.
Incluye de 6 a 8 diálogos progresivos alternando constantemente entre estas emociones EXACTAS ("normal", "pensando", "feliz", "molesta", "examen"):
{
"dialogos": [
  { "texto": "introducción al concepto", "emocion": "normal" },
  { "texto": "explicación profunda o analogía", "emocion": "pensando" },
  { "texto": "aclaración importante", "emocion": "feliz" },
  { "texto": "advertencia de error común", "emocion": "molesta" },
  { "texto": "preparación para la prueba", "emocion": "examen" }
],
"preguntas": [
  { "pregunta": "¿...?", "opciones": ["Opción incorrecta 1", "Opción incorrecta 2", "Opción correcta"], "correcta": 2, "insulto": "¡Idiota!" }
]}`;

        try {
            const respuestaBruta = await enviarMensaje("gemini-3.5-flash", config.apiKey, promptMateria, config.aiPrompt);
            const matchJson = respuestaBruta.match(/\{[\s\S]*\}/);
            if (!matchJson) throw new Error("La IA no devolvió un JSON estructurado.");
            claseData = JSON.parse(matchJson[0]);

            estadoActual = 'teoria'; dialogoIndex = 0; preguntaIndex = 0; aciertos = 0; mostrarDialogo();
