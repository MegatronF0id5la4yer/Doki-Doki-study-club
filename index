    // Descarga las materias actuales (predeterminadas + agregadas) como archivo .json
    // Una vez descargado, ese archivo permite recuperar las materias sin conexión,
    // usando internet solo cuando la IA responde preguntas dentro de una clase.
    function descargarMateriasJSON() {
        try {
            const payload = {
                version: 1,
                exportadoEn: new Date().toISOString(),
                materias: configGlobal.materias
            };
            const blob = new Blob([JSON.stringify(payload, null, 2)], { type: 'application/json' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = 'materias_ddlc.json';
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
        } catch (e) {
            console.error('Error al descargar materias', e);
            alert('No se pudo generar el archivo JSON de materias.');
        }
    }

    // Importa materias desde un archivo .json previamente descargado.
    // Valida la estructura mínima (id, nombre, niveles) antes de reemplazar la lista actual.
    function importarMateriasDesdeArchivo(event) {
        const input = event.target;
        const file = input.files && input.files[0];
        if (!file) return;

        const reader = new FileReader();
        reader.onload = () => {
            try {
                const data = JSON.parse(reader.result);
                const materias = Array.isArray(data) ? data : data.materias;

                if (!Array.isArray(materias) || !materias.every(m => m && typeof m.id === 'string' && typeof m.nombre === 'string' && Array.isArray(m.niveles))) {
                    throw new Error('Estructura de JSON inválida');
                }

                configGlobal.materias = materias;
                guardarConfiguracion();
                renderizarListaMateriasConfig();
                alert('Materias importadas correctamente.');
            } catch (e) {
                console.error('Error al importar materias', e);
                alert('El archivo no tiene un formato válido de materias.');
            } finally {
                input.value = '';
            }
        };
        reader.onerror = () => {
            alert('No se pudo leer el archivo.');
            input.value = '';
        };
        reader.readAsText(file);
    }

