    // "matrix": lluvia de caracteres estilo Matrix sobre la pantalla, se apaga solo.
    let matrixIntervalId = null;
    function ejecutarMatrixRain() {
        const canvas = document.getElementById('matrix-rain-canvas');
        const ctx = canvas.getContext('2d');
        canvas.width = window.innerWidth;
        canvas.height = window.innerHeight;
        canvas.style.display = 'block';

        const letras = 'アイウエオカキクケコサシスセソ01デデDDLC'.split('');
        const tamFuente = 16;
        const columnas = Math.floor(canvas.width / tamFuente);
        const gotas = Array(columnas).fill(1);

        if (matrixIntervalId) clearInterval(matrixIntervalId);
        matrixIntervalId = setInterval(() => {
            ctx.fillStyle = 'rgba(0,0,0,0.08)';
            ctx.fillRect(0, 0, canvas.width, canvas.height);
            ctx.fillStyle = '#0f0';
            ctx.font = tamFuente + 'px monospace';
            gotas.forEach((y, i) => {
                const texto = letras[Math.floor(Math.random() * letras.length)];
                ctx.fillText(texto, i * tamFuente, y * tamFuente);
                if (y * tamFuente > canvas.height && Math.random() > 0.975) gotas[i] = 0;
                gotas[i]++;
            });
        }, 40);

        setTimeout(() => {
            clearInterval(matrixIntervalId);
            matrixIntervalId = null;
            canvas.style.display = 'none';
            ctx.clearRect(0, 0, canvas.width, canvas.height);
        }, 6000);
    }

