    // "checkassets": recorre todos los sprites registrados y avisa cuáles no cargan (404).
    async function ejecutarComandoAssetCheck(log) {
        log.innerText += "\n[SYSTEM] Iniciando escaneo de sprites...";

        const rutas = new Set();
        Object.values(SETS_AVATARES).forEach(set => {
            Object.values(set.sprites).forEach(item => {
                if (Array.isArray(item)) item.forEach(src => rutas.add(src));
                else if (typeof item === 'string') rutas.add(item);
            });
        });
        CATALOGO_NATSUKI_ESCUELA.forEach(archivo => rutas.add(`img/natsuki escuela/${archivo}`));

        const lista = Array.from(rutas);
        let rotos = 0, correctos = 0;

        for (const url of lista) {
            const ok = await new Promise(resolve => {
                const img = new Image();
                img.onload = () => resolve(true);
                img.onerror = () => resolve(false);
                img.src = url;
            });
            if (!ok) { rotos++; log.innerText += `\n[FAIL] 404/Missing: ${url}`; }
            else { correctos++; }
        }

        log.innerText += `\n[SYSTEM] Escaneo finalizado: ${correctos} cargados, ${rotos} fallidos.`;
    }

