    async function ejecutarComandoAssetCheck() {
        const logBox = document.getElementById('consola-log');
        logBox.innerHTML = '<span style="color:#ff3377;">Iniciando escaneo de sprites...</span>\n';

        const rutas = new Set();

        Object.values(SETS_AVATARES).forEach(set => {
            Object.values(set.sprites).forEach(item => {
                if (Array.isArray(item)) {
                    item.forEach(src => rutas.add(src));
                } else if (typeof item === 'string') {
                    rutas.add(item);
                }
            });
        });

        CATALOGO_NATSUKI_ESCUELA.forEach(archivo => {
            rutas.add(`img/natsuki escuela/${archivo}`);
        });

        const lista = Array.from(rutas);
        let rotos = 0;
        let correctos = 0;

        for (const url of lista) {
            const ok = await new Promise(resolve => {
                const img = new Image();
                img.onload = () => resolve(true);
                img.onerror = () => resolve(false);
                img.src = url;
            });

            if (!ok) {
                rotos++;
                logBox.innerHTML += `<span style="color:#ff4444;">[FAIL] 404/Missing: ${url}</span>\n`;
                console.error(`[ASSET CHECK FAIL] ${url}`);
            } else {
                correctos++;
            }
        }

        logBox.innerHTML += `\n<span style="color:#0f0;">Escaneo finalizado: ${correctos} cargados, ${rotos} fallidos.</span>`;
    }

    document.getElementById('consola-input').addEventListener('keypress', function (e) {
        if (e.key === 'Enter') {
            const valor = this.value.trim();
            const logBox = document.getElementById('consola-log');
            const cleanCmd = valor.toLowerCase().replace(/\s+/g, ' ');
            const args = cleanCmd.split(' ');

            if (cleanCmd === 'exit' || cleanCmd === 'quit') {
                toggleConsola();
            } else if (cleanCmd === 'clear' || cleanCmd === 'cls') {
                logBox.innerHTML = '';
            } else if (cleanCmd === 'help') {
                logBox.innerHTML = "Comandos disponibles:\n - setlevel [materia] [lvl]\n - checkassets\n - exit / quit\n - clear / cls\n - ...y algunos paquetes de pacman ;)";
            } else if (cleanCmd === 'sudo pacman -s cute kawai girlfriend' || cleanCmd === 'sudo pacman -s cute kawaii girlfriend') {
                ejecutarMicroescenaNatsuki();
            } else if (cleanCmd.startsWith('sudo pacman -s')) {
                logBox.innerHTML += `<span style="color:#ff4444;">error: objetivo no encontrado: ${valor.replace(/sudo pacman -s/i, '').trim()}\n¿Por qué no pruebas instalando afecto femenino primero?</span>\n`;
            } else if (cleanCmd === 'os.remove("monika.chr")' || cleanCmd === 'rm monika.chr') {
                logBox.innerHTML += `<span style="color:#ff3377;">[Monika]: Buen intento. Pero tengo permisos de superusuario aquí dentro.</span>\n`;
            } else if (cleanCmd === 'just monika') {
                seleccionarSetAvatar('monika_escuela', 'monika');
                logBox.innerHTML += `<span style="color:#0f0;">Realidad reescrita: Monika ha tomado el control.</span>\n`;
            } else if (cleanCmd.startsWith('sudo rm -rf')) {
                document.getElementById('vn-container').classList.add('shake');
                setTimeout(() => document.getElementById('vn-container').classList.remove('shake'), 500);
                logBox.innerHTML += `<span style="color:#f33;">[KERNEL PANIC]: Destrucción del espacio de trabajo denegada por protocolo escolar.</span>\n`;
            } else if (args[0] === 'setlevel' && args.length === 3 && config.materias.some(m => m.id === args[1]) && !isNaN(args[2])) {
                niveles[args[1]] = parseInt(args[2]);
                localStorage.setItem(`lvl_${args[1]}`, args[2]);
                renderMenuMaterias();
                logBox.innerHTML += `<span style="color:#0f0;">Nivel de ${args[1]} actualizado a ${args[2]}.</span>\n`;
            } else if (args[0] === 'checkassets') {
                ejecutarComandoAssetCheck();
            } else {
                logBox.innerHTML += `<span style="color:#f77;">Comando no reconocido: "${valor}". Escribe 'help' o 'exit'.</span>\n`;
            }

            this.value = '';
        }
    });

    window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
            if (document.getElementById('galeria-sprites-modal').style.display === 'flex') { cerrarCatalogoGeneral(); return; }
            document.getElementById('consola-hack').style.display = 'none';
            if (document.getElementById('rpg-menu').classList.contains('abierto')) toggleMenuLateral(false);
            else if (estadoActual === 'duda') cancelarDuda();
        } else if (e.key === 'Enter' && estadoActual === 'duda' && document.activeElement === document.getElementById('input-duda')) enviarDuda();
    });

    inicializarUI_IA(); renderAvataresUI(); renderFondosUI(); renderMenuMaterias(); reproducirBGM('menu');
</script>
</body>
</html>
