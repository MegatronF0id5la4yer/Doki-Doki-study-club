    async function generarExplicacionIA() {
        const txt = document.getElementById('dialogue-text');
        txt.style.display = 'block';
        document.getElementById('options-container').style.display = 'none';
        txt.innerHTML = `<span class="loading-dots">Generando lección con IA</span>`;

        const mat = configGlobal.materias.find(m => m.id === estadoClase.materiaId);
        const lvl = mat ? mat.niveles.find(l => l.id === estadoClase.nivelId) : null;

        const promptSystem = configGlobal.promptPersonal || PROMPTS_BASE[configGlobal.personajeNombre] || PROMPTS_BASE.natsuki;
        const promptUser = `Explica el tema "${lvl ? lvl.nombre : 'Conceptos'}" de la materia ${mat ? mat.nombre : 'Estudios'}.
                            Descripción: ${lvl ? lvl.descripcion : ''}.
                            Usa tu personalidad definida. Da una explicación breve, clara y conceptual (máximo 120 palabras).`;

        try {
            const resp = await llamarServicioIA(configGlobal.apiKey, configGlobal.modelo, promptSystem, promptUser);
            txt.innerText = resp;
            estadoClase.historialChat.push({ role: 'model', parts: [{ text: resp }] });
            mostrarSpriteDoki('feliz');
        } catch (err) {
            txt.innerText = `[Error de conexión IA]: Explicación offline para ${lvl ? lvl.nombre : 'este tema'}.\nRecuerda revisar los conceptos clave antes del examen.`;
            mostrarSpriteDoki('pensando');
        }

        const btnNext = document.getElementById('btn-next-dialog');
        btnNext.style.display = 'inline-block';
        btnNext.innerText = 'Iniciar Examen ▶';
        btnNext.onclick = () => iniciarExamen();
    }

    async function iniciarExamen() {
        reproducirBGM('examen');
        mostrarSpriteDoki('examen');
        const txt = document.getElementById('dialogue-text');
        txt.innerHTML = `<span class="loading-dots">Preparando preguntas del examen</span>`;

        const mat = configGlobal.materias.find(m => m.id === estadoClase.materiaId);
        const lvl = mat ? mat.niveles.find(l => l.id === estadoClase.nivelId) : null;

        const promptSystem = "Eres un evaluador académico. Genera un examen de 3 preguntas de opción múltiple en formato JSON estricto.";
        const promptUser = `Genera un examen sobre "${lvl ? lvl.nombre : 'Tema'}" en JSON con esta estructura exacta:
        [
          {"pregunta": "...", "opciones": ["A", "B", "C", "D"], "correcta": 0},
          {"pregunta": "...", "opciones": ["A", "B", "C", "D"], "correcta": 1},
          {"pregunta": "...", "opciones": ["A", "B", "C", "D"], "correcta": 2}
        ]`;

        try {
            const resp = await llamarServicioIA(configGlobal.apiKey, configGlobal.modelo, promptSystem, promptUser, true);
            const preguntas = JSON.parse(resp);
            estadoClase.preguntasExamen = preguntas;
            estadoClase.pasoActual = 0;
            estadoClase.puntosExamen = 0;
            desplegarPreguntaExamen();
        } catch (e) {
            estadoClase.preguntasExamen = [
                { pregunta: "¿Cuál es la respuesta correcta básica?", opciones: ["Opción A", "Opción B", "Opción C", "Opción D"], correcta: 0 },
                { pregunta: "Selecciona el concepto válido:", opciones: ["Incorrecto", "Correcto", "Incorrecto", "Falso"], correcta: 1 }
            ];
            estadoClase.pasoActual = 0;
            estadoClase.puntosExamen = 0;
            desplegarPreguntaExamen();
        }
    }

    function desplegarPreguntaExamen() {
        const p = estadoClase.preguntasExamen[estadoClase.pasoActual];
        if (!p) {
            finalizarExamen();
            return;
        }

        document.getElementById('dialogue-text').style.display = 'block';
        document.getElementById('options-container').style.display = 'none';
        document.getElementById('btn-duda').style.display = 'none';

        document.getElementById('dialogue-text').innerText = `Pregunta ${estadoClase.pasoActual + 1}:\n${p.pregunta}`;

