    function reproducirBGM(tipo) {
        if (bgmMuted || !PISTAS_AUDIO[tipo]) return;
        const ruta = PISTAS_AUDIO[tipo];
        if (pistaActual === ruta && !bgmPlayer.paused) return;
        pistaActual = ruta; bgmPlayer.src = ruta;
        bgmPlayer.play().catch(() => { window.addEventListener('click', () => { if (pistaActual && !bgmMuted) bgmPlayer.play(); }, { once: true }); });
    }

    function toggleBGM() {
        bgmMuted = !bgmMuted;
        const btn = document.getElementById('btn-bgm-toggle');
