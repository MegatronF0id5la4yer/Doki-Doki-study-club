    async function iniciarSesion(materiaId) {
        materiaActual = materiaId;
        const nombreMat = config.materias.find(x => x.id === materiaId)?.nombre || materiaId;
        const nivelActual = niveles[materiaId] || 1;

        toggleMenuLateral(false);
        rpgTab.style.display = 'none';

