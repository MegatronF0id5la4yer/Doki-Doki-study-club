    const bgmPlayer = new Audio();
    bgmPlayer.loop = true;
    let bgmMuted = false;
    let pistaActual = '';

    function reproducirBGM(tipo) {
        if (bgmMuted || !PISTAS_AUDIO[tipo]) return;
        const ruta = PISTAS_AUDIO[tipo];
        if (pistaActual === ruta && !bgmPlayer.paused) return;
        pistaActual = ruta; bgmPlayer.src = ruta;
        bgmPlayer.play().catch(() => { window.addEventListener('click', () => { if (pistaActual && !bgmMuted) bgmPlayer.play(); }, { once: true }); });
    }

    function toggleBGM() {
        bgmMuted = !bgmMuted;
        const btn = document.getElementById('btn-bgm-toggle');
        if (bgmMuted) { bgmPlayer.pause(); btn.innerText = 'BGM: OFF ✕'; btn.style.background = '#777'; }
        else { btn.innerText = 'BGM: ON ♫'; btn.style.background = 'rgba(255, 122, 162, 0.85)'; if (pistaActual) bgmPlayer.play(); }
    }

    function ajustarVolumen(valor) { bgmPlayer.volume = parseFloat(valor); }

    function toggleFullScreen() {
        if (!document.fullscreenElement) {
            document.documentElement.requestFullscreen().catch(err => {
                console.log(`Error al iniciar pantalla completa: ${err.message}`);
            });
        } else {
            if (document.exitFullscreen) {
                document.exitFullscreen();
            }
        }
    }

