<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Academia del Sufrimiento - DDLC Edition</title>
    <style>
        :root {
            --color-ddlc-pink: #ff7aa2;
            --color-ddlc-hotpink: #ff3377;
            --color-ddlc-white: #ffffff;
            --color-textbox-bg: rgba(255, 240, 245, 0.95);
            --color-texto: #222222;
            --url-fondo-clase: url('img/bg/classroom.webp');
            --url-fondo-menu: url('img/bg/bgmenu.webp');
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            background-color: #1a0814;
            color: #fff;
            font-family: 'Comic Sans MS', 'Arial Rounded MT Bold', system-ui, sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            overflow: hidden;
            user-select: none;
        }

        #vn-container {
            width: 96vw;
            max-width: 1600px;
            height: calc(96vw * 9 / 16);
            max-height: 94vh;
            position: relative;
            overflow: hidden;
            border-radius: 12px;
            border: none;
            box-shadow: none;
            background-image: var(--url-fondo-clase);
            background-size: cover;
            background-position: center;
            image-rendering: optimizeQuality;
        }

        #menu-screen {
            position: absolute; top: 0; left: 0; width: 100%; height: 100%;
            background-image: var(--url-fondo-menu);
            background-size: cover;
            background-position: center;
            z-index: 100;
            display: flex;
            overflow: hidden;
        }

        .ddlc-dots-overlay {
            position: absolute; top: 0; left: 0; width: 100%; height: 100%;
            background-image: radial-gradient(rgba(255, 255, 255, 0.35) 15%, transparent 16%),
                              radial-gradient(rgba(255, 255, 255, 0.35) 15%, transparent 16%);
            background-size: 60px 60px;
            background-position: 0 0, 30px 30px;
            pointer-events: none;
            animation: moveDots 25s linear infinite;
        }

        @keyframes moveDots {
            from { background-position: 0 0, 30px 30px; }
            to { background-position: 600px 600px, 630px 630px; }
        }

        .ddlc-menu-sidebar {
            position: relative;
            z-index: 10;
            width: 380px;
            height: 100%;
            background: linear-gradient(135deg, rgba(255, 182, 193, 0.92) 0%, rgba(255, 130, 170, 0.94) 100%);
            border-right: 6px solid #fff;
            box-shadow: 10px 0 30px rgba(0, 0, 0, 0.35);
            display: flex;
            flex-direction: column;
            justify-content: center;
            padding: 30px 25px;
            transform: skewX(-4deg);
            margin-left: -20px;
        }

        .ddlc-menu-sidebar > * { transform: skewX(4deg); }

        .ddlc-logo-box { margin-bottom: 25px; text-align: center; }
        .ddlc-logo-main {
            font-size: 32px; font-weight: 900; color: #fff;
            text-shadow: 3px 3px 0px #ff3377, 6px 6px 0px rgba(0,0,0,0.15);
            letter-spacing: 1px; line-height: 1.1;
        }

        .ddlc-logo-sub {
            display: inline-block; background: #fff; color: #ff3377;
            font-size: 13px; font-weight: 900; padding: 3px 12px;
            border-radius: 12px; box-shadow: 2px 2px 0px rgba(0,0,0,0.1); margin-top: 6px;
        }

        .ddlc-nav-list { display: flex; flex-direction: column; gap: 12px; }

        .ddlc-btn {
            background: #ffffff; color: #ff3377; border: 2px solid #ff7aa2;
            padding: 12px 22px; border-radius: 25px; font-size: 17px; font-weight: 900;
            letter-spacing: 1px; cursor: pointer; text-align: left;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.12), inset 0 -2px 0 rgba(0,0,0,0.1);
            transition: all 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            display: flex; align-items: center; justify-content: space-between;
        }

        .ddlc-btn:hover {
            transform: scale(1.04) translateX(8px); background: #fff0f5;
            border-color: #ff1493; color: #ff1493;
            box-shadow: 0 6px 14px rgba(255, 51, 119, 0.35);
        }

        .ddlc-btn-badge { background: #ff3377; color: #fff; border-radius: 12px; padding: 2px 8px; font-size: 11px; }

        #ddlc-materias-panel {
            display: none; flex-direction: column; gap: 8px;
            max-height: 280px; overflow-y: auto; padding-right: 4px;
        }

        .ddlc-btn-submateria {
            background: rgba(255, 255, 255, 0.95); color: #444; border: 2px solid #ffb6c1;
            padding: 10px 16px; border-radius: 18px; font-size: 14px; font-weight: 800;
            cursor: pointer; display: flex; justify-content: space-between; align-items: center; transition: 0.15s;
            user-select: none;
        }

        .ddlc-btn-submateria:hover {
            background: #ff3377; color: #fff; border-color: #fff; transform: translateX(6px);
        }
        .ddlc-btn-submateria:active { transform: scale(0.98); }

        .ddlc-btn-back {
            background: rgba(0,0,0,0.15); color: #fff; border: none; padding: 6px 14px;
            border-radius: 12px; font-size: 12px; font-weight: bold; cursor: pointer;
            margin-bottom: 6px; align-self: flex-start;
        }
        .ddlc-btn-back:hover { background: rgba(0,0,0,0.3); }

        #menu-character-preview {
            position: absolute; right: 12%; bottom: 0; height: 94%; z-index: 5;
            filter: drop-shadow(0 0 25px rgba(255, 122, 162, 0.5)); pointer-events: none;
        }

        #character-sprite {
            position: absolute; bottom: 0; left: 22%; height: 90%;
            transform: translateX(-150%);
            transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
            z-index: 10; pointer-events: none;
            filter: drop-shadow(0 0 15px rgba(0,0,0,0.6));
        }
        #character-sprite.active { transform: translateX(0); }

        #textbox-container {
            position: absolute; bottom: 20px; left: 50%; transform: translateX(-50%);
            width: 92%; height: 185px; background: var(--color-textbox-bg);
            border: 4px solid var(--color-ddlc-pink); border-radius: 16px;
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.5); z-index: 20; display: none;
        }

        #name-box {
            position: absolute; top: -26px; left: 30px; background: #ff7aa2; color: #fff;
            padding: 5px 22px; border-radius: 10px; font-weight: bold; font-size: 20px;
            border: 2px solid #fff; box-shadow: 0 3px 6px rgba(0,0,0,0.25);
            text-shadow: 1px 1px 2px rgba(0,0,0,0.4);
            text-transform: capitalize;
        }

        #btn-salir-clase {
            position: absolute; top: -22px; right: 25px; background: #ff4466; color: #fff;
            border: 2px solid #fff; border-radius: 8px; padding: 4px 14px; font-weight: bold;
            font-size: 13px; cursor: pointer; box-shadow: 0 2px 6px rgba(0,0,0,0.3); transition: 0.15s;
        }
        #btn-salir-clase:hover { background: #cc1133; transform: scale(1.05); }

        #dialogue-text {
            padding: 22px 35px 15px 35px; color: var(--color-texto); font-size: 20px; line-height: 1.55;
            font-weight: bold; height: 120px; overflow-y: auto; white-space: pre-wrap; word-break: break-word;
        }

        #dialogue-text::-webkit-scrollbar { width: 8px; }
        #dialogue-text::-webkit-scrollbar-thumb { background: var(--color-ddlc-hotpink); border-radius: 4px; }

        .dialogue-ctrls { position: absolute; bottom: 12px; right: 20px; display: flex; gap: 10px; }

        .game-btn {
            background: #ff7aa2; color: #fff; border: 2px solid #fff; padding: 6px 18px;
            border-radius: 14px; font-size: 14px; font-weight: bold; cursor: pointer;
            box-shadow: 0 2px 6px rgba(0,0,0,0.2); transition: 0.15s;
        }
        .game-btn:hover { background: #ff3377; transform: scale(1.05); }

        #options-container { display: none; padding: 15px; height: 135px; overflow-y: auto; }
        .btn-option {
            display: block; width: 90%; margin: 6px auto; padding: 9px 15px;
            background: #fff; border: 2px solid #ff7aa2; border-radius: 8px;
            color: #333; font-weight: bold; font-size: 16px; cursor: pointer; text-align: center;
        }
        .btn-option:hover { background: #ff7aa2; color: #fff; }

        #input-duda-container { display: none; padding: 25px 30px; text-align: center; }
        #input-duda {
            width: 65%; padding: 10px 15px; font-size: 16px; border: 2px solid #ff7aa2;
            border-radius: 8px; outline: none;
        }

        #btn-bgm-toggle {
            position: absolute; top: 12px; left: 12px; background: rgba(255, 122, 162, 0.85);
            color: #fff; border: 2px solid #fff; padding: 4px 10px; border-radius: 8px;
            font-size: 12px; font-weight: bold; cursor: pointer; z-index: 999; box-shadow: 0 2px 5px rgba(0,0,0,0.3);
        }
        #btn-bgm-toggle:hover { background: #ff3377; }

        #btn-fullscreen {
            position: absolute; top: 12px; left: 110px; background: rgba(0,0,0,0.5);
            color: #fff; border: 1px solid #fff; padding: 4px 10px; border-radius: 8px;
            font-size: 12px; font-weight: bold; cursor: pointer; z-index: 999;
        }
        #btn-fullscreen:hover { background: #444; }

        #btn-consola { position: absolute; top: 12px; right: 12px; background: rgba(0,0,0,0.5); color: #fff; border: 1px solid #fff; cursor: pointer; z-index: 999; padding: 3px 8px; font-family: monospace; border-radius: 4px; font-size: 12px; }
        #consola-hack { display: none; position: absolute; top: 0; left: 0; width: 100%; max-height: 80vh; overflow-y: auto; background: rgba(0,0,0,0.95); color: #0f0; padding: 10px; z-index: 1000; font-family: monospace; }
        #consola-input { background: transparent; border: none; color: #0f0; width: 80%; outline: none; font-family: monospace; }
        #consola-log { margin-top: 8px; font-size: 11px; white-space: pre-wrap; word-break: break-all; }

        #rpg-tab {
            position: fixed; top: 50%; left: 0; transform: translateY(-50%);
            background: #ff7aa2; color: #fff; border: 2px solid #fff; border-left: none;
            padding: 16px 8px; border-radius: 0 10px 10px 0; font-weight: bold; font-size: 12px;
            letter-spacing: 2px; cursor: pointer; z-index: 2500; writing-mode: vertical-rl;
            box-shadow: 2px 0 10px rgba(0,0,0,0.3); transition: all 0.3s ease; display: block;
        }
        #rpg-tab:hover { background: #ff3377; }
        #rpg-tab.abierto { left: 420px; }

        #rpg-overlay {
            position: fixed; top: 0; left: 0; width: 100vw; height: 100vh;
            background: rgba(0,0,0,0.5); z-index: 2400; display: none; pointer-events: none;
        }
        #rpg-overlay.activo { display: block; pointer-events: auto; }

        #rpg-menu {
            position: fixed; top: 0; left: -450px; width: 420px; max-width: 90vw; height: 100%;
            background: rgba(255, 245, 248, 0.98); border-right: 3px solid #ff7aa2;
            box-shadow: 10px 0 35px rgba(0,0,0,0.4); z-index: 2450;
            transition: left 0.3s ease; display: flex; flex-direction: column; color: #333;
        }
        #rpg-menu.abierto { left: 0; }

        #rpg-menu-header {
            padding: 16px; font-size: 15px; font-weight: 900; color: #ff3377;
            border-bottom: 2px solid #ffb6c1; display: flex; justify-content: space-between; align-items: center;
        }

        #rpg-tabs-nav { display: flex; border-bottom: 2px solid #ffb6c1; flex-wrap: wrap; }
        .rpg-tab-btn {
            flex: 1 1 20%; padding: 12px 6px; background: none; color: #777; border: none; cursor: pointer;
            font-size: 12px; font-weight: 800; text-transform: uppercase;
        }
        .rpg-tab-btn.activo { color: #ff3377; border-bottom: 3px solid #ff3377; background: #ffe4ec; }

        #rpg-menu-body { flex: 1; overflow-y: auto; padding: 18px; }
        .rpg-panel { display: none; }
        .rpg-panel.activo { display: block; }

        #galeria-sprites-modal {
            display: none; position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%);
            width: 540px; max-height: 600px; background: #fff0f5; border: 4px solid #ff7aa2;
            border-radius: 14px; z-index: 3000; box-shadow: 0 0 40px rgba(0,0,0,0.6); flex-direction: column; padding: 15px;
        }
        #galeria-sprites-grid {
            display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; overflow-y: auto; max-height: 480px; padding: 5px;
        }
        .item-sprite-galeria {
            background: #fff; border: 1px solid #ffb6c1; border-radius: 6px;
            cursor: pointer; padding: 5px; text-align: center; transition: 0.2s;
        }
        .item-sprite-galeria:hover { border-color: #ff3377; transform: scale(1.05); }
        .item-sprite-galeria img { width: 100%; height: 80px; object-fit: contain; }
        .item-sprite-galeria span { display: block; font-size: 9px; color: #444; margin-top: 3px; word-break: break-all; font-weight: bold; }

        .loading-dots:after {
            content: ' .';
            animation: dots 1.5s steps(5, end) infinite;
        }
        @keyframes dots {
            0%, 20% { color: transparent; text-shadow: .25em 0 0 transparent, .5em 0 0 transparent; }
            40% { color: #222; text-shadow: .25em 0 0 transparent, .5em 0 0 transparent; }
            60% { text-shadow: .25em 0 0 #222, .5em 0 0 transparent; }
            80%, 100% { text-shadow: .25em 0 0 #222, .5em 0 0 #222; }
        }

        @keyframes trauma { 0% { transform: translate(0, 0); } 20% { transform: translate(-10px, 5px); } 40% { transform: translate(10px, -5px); } 60% { transform: translate(-10px, 10px); } 80% { transform: translate(10px, -10px); } 100% { transform: translate(0, 0); } }
        .shake { animation: trauma 0.3s; }

        .selector-panel { background: #fff0f5; border: 2px solid #ffb6c1; padding: 12px; margin-bottom: 15px; border-radius: 8px; }
        .selector-header { color: #ff3377; font-size: 12px; margin-bottom: 10px; border-bottom: 2px solid #ffb6c1; padding-bottom: 5px; font-weight: bold; letter-spacing: 1px; }
        .selector-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 6px; margin-bottom: 15px; }
        .selector-card { background: #ffffff; color: #ff7aa2; border: 2px solid #ffb6c1; padding: 8px; text-align: center; cursor: pointer; text-transform: uppercase; font-weight: bold; font-size: 11px; transition: 0.2s; border-radius: 6px; }
        .selector-card:hover { background: #ffe4ec; border-color: #ff3377; color: #ff3377; }
        .selector-card.viendo { background: #ff3377; border-color: #ff3377; color: #ffffff; box-shadow: 0 0 8px rgba(255,51,119,0.4); }

        .grid-tarjetas {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 8px;
            margin-top: 10px;
        }
        .tarjeta-item {
            background: #fff0f5;
            border: 2px solid #ffb6c1;
            border-radius: 6px;
            height: 120px;
            cursor: pointer;
            background-size: cover;
            background-position: top center;
            transition: 0.2s;
            position: relative;
            overflow: hidden;
        }
        .tarjeta-item:hover { border-color: #ff3377; transform: scale(1.05); }
        .tarjeta-item.activo { border: 3px solid #ff3377; box-shadow: 0 0 12px rgba(255, 51, 119, 0.6); }
        .tarjeta-label {
            position: absolute; bottom: 0; left: 0; width: 100%;
            background: rgba(255, 51, 119, 0.95); color: #fff;
            font-size: 10px; text-align: center; padding: 4px 0;
            font-weight: bold; text-transform: uppercase;
        }
    </style>
</head>
<body>

<div id="rpg-overlay" onclick="toggleMenuLateral(false)"></div>
<div id="rpg-tab" onclick="toggleMenuLateral()">AJUSTES</div>

<div id="rpg-menu">
    <div id="rpg-menu-header">
        <span>CONFIGURACIÓN DEL JUEGO</span>
        <button class="game-btn" style="padding: 4px 12px; font-size: 14px; background: #ff3377;" onclick="toggleMenuLateral(false)">✕ Cerrar</button>
    </div>
    <div id="rpg-tabs-nav">
        <button class="rpg-tab-btn activo" onclick="cambiarPanelMenu('panel-ai', this)">IA & Prompts</button>
        <button class="rpg-tab-btn" onclick="cambiarPanelMenu('panel-avatares', this)">Avatares</button>
        <button class="rpg-tab-btn" onclick="cambiarPanelMenu('panel-fondos', this)">Fondos</button>
        <button class="rpg-tab-btn" onclick="cambiarPanelMenu('panel-materias', this)">Materias</button>
        <button class="rpg-tab-btn" onclick="cambiarPanelMenu('panel-audio', this)">Audio</button>
    </div>

    <div id="rpg-menu-body">
        <div class="rpg-panel activo" id="panel-ai">
            <div style="font-size:12px; font-weight:bold; color:#ff3377; margin-bottom:6px;">API KEY PERSONAL</div>
            <input type="password" id="input-ai-key" class="input-config" placeholder="Pega tu clave de IA aqui..." onchange="guardarConfigIA()">

            <div style="font-size:12px; font-weight:bold; color:#ff3377; margin-bottom:6px;">PROVEEDOR DE IA</div>
            <select id="select-ai-model" class="input-config" onchange="guardarConfigIA()">
                <option value="gemini-3.5-flash">Gemini 3.5 Flash</option>
            </select>

            <div style="font-size:12px; font-weight:bold; color:#ff3377; margin-bottom:6px;">COMPORTAMIENTO / PROMPT DEL SUJETO</div>
            <textarea id="textarea-ai-prompt" class="input-config" style="height: 130px; resize: vertical;"
                      placeholder="Instrucciones para la personalidad..." onchange="guardarConfigIA()"></textarea>

            <button class="game-btn" style="width: 100%;" onclick="restaurarPromptDefault()">Restaurar Prompt Actual</button>
        </div>

        <div class="rpg-panel" id="panel-avatares">
            <button class="game-btn" style="width: 100%; margin-bottom: 15px;" onclick="abrirCatalogoGeneral()">📂 Ver Catálogo Completo de Sprites</button>
            <div id="selector-avatar-container"></div>
        </div>

        <div class="rpg-panel" id="panel-fondos">
            <div class="selector-header">ENTORNO DE SIMULACIÓN</div>
            <div class="grid-tarjetas" id="grid-fondos"></div>
        </div>

        <div class="rpg-panel" id="panel-materias">
            <div style="margin-bottom: 15px;">
                <div style="font-size:12px; font-weight:bold; color:#ff3377; margin-bottom:6px;">AGREGAR MATERIA</div>
                <input type="text" id="input-nueva-materia" class="input-config" placeholder="Nombre (ej. Termodinámica)">
                <button class="game-btn" style="width: 100%;" onclick="agregarMateria()">+ Registrar</button>
            </div>
            <div style="font-size:12px; font-weight:bold; color:#ff3377; margin-bottom:6px;">MATERIAS ACTIVAS</div>
            <div id="lista-materias-config"></div>
            <button class="game-btn" style="width: 100%; margin-top: 15px; background: #666;" onclick="restaurarMateriasPorDefecto()">Restaurar Default</button>
            <button class="game-btn" style="width: 100%; margin-top: 8px; background: #e33;" onclick="resetearNiveles()">Borrar Todo el Progreso</button>
        </div>

        <div class="rpg-panel" id="panel-audio">
            <div style="font-size:13px; font-weight:bold; color:#ff3377; margin-bottom:12px;">CONTROL DE VOLUMEN</div>
            <label style="font-size:12px; display:block; margin-bottom:6px;">Volumen BGM:</label>
            <input type="range" id="slider-volumen" min="0" max="1" step="0.05" value="0.5"
                   style="width: 100%; margin-bottom: 15px;" onchange="ajustarVolumen(this.value)">
        </div>
    </div>
</div>

<div id="galeria-sprites-modal">
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px;">
        <span style="font-weight:bold; color:#ff3377;">CATÁLOGO DE SPRITES</span>
        <button class="game-btn" style="padding:2px 8px; background:#f44;" onclick="cerrarCatalogoGeneral()">✕</button>
    </div>
    <div id="galeria-sprites-grid"></div>
</div>

<div id="vn-container">
    <button id="btn-bgm-toggle" onclick="toggleBGM()">BGM: ON ♫</button>
    <button id="btn-fullscreen" onclick="toggleFullScreen()">[ ⛶ ]</button>
    <button id="btn-consola" onclick="toggleConsola()">[ CMD ]</button>

    <div id="consola-hack">
        <div>[ROOT@DDLC]:~$ <input type="text" id="consola-input" autocomplete="off" placeholder="Escribe 'help' o 'exit'"></div>
        <div id="consola-log"></div>
    </div>

    <div id="menu-screen">
        <div class="ddlc-dots-overlay"></div>

        <div class="ddlc-menu-sidebar">
            <div class="ddlc-logo-box">
                <div class="ddlc-logo-main">Doki Doki<br>Study Club!</div>
                <div class="ddlc-logo-sub">EDICIÓN DE APRENDIZAJE</div>
            </div>

            <div class="ddlc-nav-list" id="ddlc-nav-main">
                <button class="ddlc-btn" onclick="abrirSelectorMaterias()">
                    <span>Nueva Lección</span>
                    <span class="ddlc-btn-badge">▶</span>
                </button>
                <button class="ddlc-btn" id="btn-abrir-ajustes" onclick="toggleMenuLateral(true)">
                    <span>Ajustes & Avatares</span>
                    <span>⚙</span>
                </button>
                <button class="ddlc-btn" onclick="resetearNiveles()">
                    <span>Reiniciar Datos</span>
                    <span>✕</span>
                </button>
            </div>

            <div id="ddlc-materias-panel">
                <button class="ddlc-btn-back" onclick="cerrarSelectorMaterias()">◀ Volver al Menú</button>
                <div id="contenedor-submaterias" style="display:flex; flex-direction:column; gap:6px;"></div>
            </div>
        </div>
        <img id="menu-character-preview" src="img/natsuki escuela/Schoola.webp" alt="Menu Preview">
    </div>

    <img id="character-sprite" src="img/natsuki escuela/Schoola.webp" alt="Character">

    <div id="textbox-container">
        <div id="name-box">Natsuki</div>
        <button id="btn-salir-clase" onclick="volverAlMenu()">Salir ✕</button>
        <div id="dialogue-text">...</div>
        <div id="options-container"></div>

        <div id="input-duda-container">
            <input type="text" id="input-duda" placeholder="Pregunta tu duda...">
            <button class="game-btn" onclick="enviarDuda()">Preguntar</button>
            <button class="game-btn" style="background:#777;" onclick="cancelarDuda()">Cancelar</button>
        </div>

        <div class="dialogue-ctrls">
            <button class="game-btn" id="btn-next-dialog" onclick="avanzarDialogo()">Siguiente ▶</button>
            <button class="game-btn" id="btn-duda" onclick="abrirDuda()">Tengo una duda</button>
        </div>
    </div>
</div>

<script src="ai_services.js"></script>

<script>
