        const btnNext = document.getElementById('btn-next-dialog');
        btnNext.style.display = 'inline-block';
        btnNext.innerText = 'Ver Opciones ▶';
        btnNext.onclick = () => {
            btnNext.style.display = 'none';
            document.getElementById('dialogue-text').style.display = 'none';
            const optCont = document.getElementById('options-container');
            optCont.style.display = 'block';
            optCont.innerHTML = '';

            p.opciones.forEach((op, index) => {
                const b = document.createElement('button');
                b.className = 'btn-option';
                b.innerText = op;
                b.onclick = () => responderPregunta(index);
                optCont.appendChild(b);
            });
        };
    }

    function responderPregunta(indice) {
        const p = estadoClase.preguntasExamen[estadoClase.pasoActual];
        const esCorrecta = (indice === p.correcta);

        const fb = FEEDBACK_PERSONAJES[configGlobal.personajeNombre] || FEEDBACK_PERSONAJES.natsuki;

        document.getElementById('options-container').style.display = 'none';
        document.getElementById('dialogue-text').style.display = 'block';

        if (esCorrecta) {
            estadoClase.puntosExamen++;
            mostrarSpriteDoki('feliz');
            document.getElementById('dialogue-text').innerText = fb.acierto;
        } else {
            mostrarSpriteDoki('molesta');
            document.getElementById('dialogue-text').innerText = fb.errorDefault;
        }

        const btnNext = document.getElementById('btn-next-dialog');
        btnNext.style.display = 'inline-block';
        btnNext.innerText = 'Siguiente ▶';
        btnNext.onclick = () => {
            estadoClase.pasoActual++;
            desplegarPreguntaExamen();
        };
    }

    function finalizarExamen() {
        reproducirBGM('resultados');
        const total = estadoClase.preguntasExamen.length;
        const aciertos = estadoClase.puntosExamen;
        const aprobado = (aciertos / total) >= 0.6;

        const fb = FEEDBACK_PERSONAJES[configGlobal.personajeNombre] || FEEDBACK_PERSONAJES.natsuki;
        let msj = aprobado ? fb.aprobado(aciertos, total, 2) : fb.reprobado(aciertos, total, 1);

        document.getElementById('dialogue-text').style.display = 'block';
        document.getElementById('options-container').style.display = 'none';
        document.getElementById('dialogue-text').innerText = msj;

        if (aprobado) {
            mostrarSpriteDoki('feliz');
            configGlobal.progreso[estadoClase.nivelId] = true;
            guardarConfiguracion();
        } else {
            mostrarSpriteDoki('molesta');
        }

        const btnNext = document.getElementById('btn-next-dialog');
        btnNext.style.display = 'inline-block';
        btnNext.innerText = 'Volver al Menú';
        btnNext.onclick = () => volverAlMenu();
    }

