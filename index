        if (!typewriterCompleto) { forzarFinTypewriter(); return; }
        if (estadoActual === 'teoria') { dialogoIndex++; mostrarDialogo(); }
        else if (estadoActual === 'feedback') { preguntaIndex++; iniciarPractica(); }
        else if (estadoActual === 'leyendo_duda') { estadoActual = 'teoria'; reproducirBGM('teoria'); mostrarDialogo(); }
        else if (estadoActual === 'terminado') { volverAlMenu(); }
